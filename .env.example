# MySQL
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=jobpilot
MYSQL_USER=jobpilot
MYSQL_PASSWORD=change_me

# Redis (reserved for a future authenticated local setup)
REDIS_PASSWORD=

# Service
JOBPILOT_HOST=0.0.0.0
JOBPILOT_PORT=8080
JOBPILOT_MYSQL_HOST_PORT=3306
JOBPILOT_REDIS_HOST_PORT=6379
# Host port for the containerised service: docker compose --profile app up -d
JOBPILOT_BACKEND_HOST_PORT=8080
# 0022 Web UI (opt-in): docker compose --profile app --profile web up -d
JOBPILOT_WEB_HOST_PORT=8081
JOBPILOT_WEB_IMAGE=nginx:1.27-alpine
JOBPILOT_WEB_CONTAINER_NAME=jobpilot-web
LOG_LEVEL=info
STORAGE_ROOT=storage
STORAGE_MAX_FILE_BYTES=10485760
INTERNAL_API_TOKEN=

# Resource limits
MYSQL_MAX_CONN=10
REDIS_MAX_CONN=4
REDIS_TIMEOUT_MS=1000

# Environment
APP_ENV=development
